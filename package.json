{
  "name": "neo-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning --fail-on warning",
    "db:test": "supabase test db --local",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.types.ts && prettier --write packages/db/src/database.types.ts",
    "env:local": "node scripts/env-local.mjs",
    "jobs:run": "node scripts/run-jobs.mjs",
    "jobs:watch": "node scripts/run-jobs.mjs --watch",
    "test:e2e": "pnpm --filter @neo/web test:e2e"
  },
  "prettier": "@neo/config/prettier",
  "devDependencies": {
    "@neo/config": "workspace:*",
    "prettier": "^3.10.1",
    "supabase": "^2.122.0",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3"
  }
}
