{
  "extends": "@neo/config/tsconfig/react.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node"],
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "e2e",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules"]
}
