# Variáveis do app. Localmente, gere o .env.local com `pnpm env:local` (Supabase local rodando).
# Em produção, ficam no painel da Hostinger (ADR 0017). Nunca versionar valores reais.

# Supabase: URL e chave pública (podem ir ao navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: chave secreta (só no servidor; ignora RLS, sempre filtrar company_id)
SUPABASE_SECRET_KEY=

# Segredo da rota da fila /api/jobs/run (cron da Hostinger ou pnpm jobs:run)
CRON_SECRET=

# Endereço do app (links nos e-mails, como o convite do Proprietário)
APP_URL=

# Fração dos eventos "info" gravados no banco (0 a 1; warn e acima sempre). Padrão 0.1.
LOG_INFO_SAMPLE_RATE=
